{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/cron.js": {
      "maxDuration": 120
    },
    "api/meals.js": {
      "maxDuration": 90
    },
    "api/scan.js": {
      "maxDuration": 90
    },
    "api/shopping.js": {
      "maxDuration": 90
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}